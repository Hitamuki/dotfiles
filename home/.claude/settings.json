{
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(mise:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(file:*)",
      "Bash(env)",
      "mcp__pencil"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay",
            "args": [
              "/System/Library/Sounds/Glass.aiff"
            ],
            "async": true
          },
          {
            "type": "command",
            "command": "jq -r '(.cwd // \"\") | split(\"/\") | last' | { read -r dir; osascript -e 'on run argv' -e 'display notification \"応答が完了しました\" with title \"Claude Code\" subtitle (item 1 of argv)' -e 'end run' \"$dir\"; }",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay",
            "args": [
              "/System/Library/Sounds/Funk.aiff"
            ],
            "async": true
          },
          {
            "type": "command",
            "command": "jq -r '(.message // \"入力待ちです\"), ((.cwd // \"\") | split(\"/\") | last)' | { read -r msg; read -r dir; osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\" subtitle (item 2 of argv)' -e 'end run' \"$msg\" \"$dir\"; }",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "padding": 0
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true,
    "mattpocock-skills@mattpocock": true,
    "show-me@show-me": true,
    "humanizer@humanizer": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "show-me": {
      "source": {
        "source": "github",
        "repo": "charlie947/show-me"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "light-daltonized",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true
}